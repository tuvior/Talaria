{
  "name": "talaria-tasm",
  "displayName": "Talaria TASM",
  "description": "Syntax highlighting for Talaria assembly files.",
  "version": "0.1.0",
  "publisher": "local",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "contributes": {
    "languages": [
      {
        "id": "tasm",
        "aliases": [
          "Talaria TASM",
          "tasm"
        ],
        "extensions": [
          ".tasm"
        ],
        "filenames": [
          "functions.tasm"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "tasm",
        "scopeName": "source.tasm",
        "path": "./syntaxes/tasm.tmLanguage.json"
      }
    ]
  }
}
